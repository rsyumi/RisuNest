{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-capability",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA",
        "$APPDATA/*",
        "$APPDATA/**/*",
        "$DOWNLOAD/*",
        "/data/**/*"
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*/*" },
        { "url": "https://*/**/*" },
        { "url": "http://*/*" },
        { "url": "http://*/**/*" },
        { "url": "http://*:**" }
      ]
    },
    "os:default",
    "process:default",
    "shell:allow-open",
    "deep-link:default"
  ]
}
