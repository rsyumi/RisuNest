{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-capability",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-open",
    "fs:allow-seek",
    "fs:allow-read",
    {
      "identifier": "fs:scope",
      "allow": ["$APPDATA", "$APPDATA/*", "$APPDATA/**/*", "$DOWNLOAD/*"]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*:*"
        }
      ]
    },
    "os:default",
    "process:default",
    "shell:allow-open",
    "deep-link:default",
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel",
    "barcode-scanner:allow-check-permissions",
    "barcode-scanner:allow-request-permissions"
  ]
}
