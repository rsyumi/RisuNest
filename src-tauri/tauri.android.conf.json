{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm tauribuild:android"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "scope": ["asset", "$APPDATA", "$APPDATA/*", "$APPDATA/**/*"]
      }
    }
  },
  "bundle": {
    "resources": [],
    "createUpdaterArtifacts": false,
    "android": {
      "minSdkVersion": 24
    }
  }
}
