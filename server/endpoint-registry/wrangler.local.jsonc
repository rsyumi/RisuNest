{
  // Committed local development and verification configuration.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "endpoint-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 0 * * *"],
  },
  "observability": {
    "enabled": false,
  },
  "vars": {
    "MAX_RECORDS": 10000,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "endpoint-registry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
}
