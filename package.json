{
  "name": "risunest",
  "private": true,
  "version": "1.3.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --sourcemap",
    "tauribuild": "node scripts/buildTauriFrontend.mjs --mode desktop",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
    "test": "vitest run --project=!harness",
    "tauri": "tauri",
    "buildsite": "vite build --outDir dist",
    "tauribuild:android": "node scripts/buildTauriFrontend.mjs --mode android",
    "tauribuild:agent": "node scripts/buildTauriFrontend.mjs --mode agent",
    "dev:agent": "vite --mode agent",
    "build:agent": "vite build --mode agent --sourcemap",
    "check:plugin-dts": "tsc --noEmit --skipLibCheck --target es2023 --module es2022 --moduleResolution bundler --lib es2023,dom src/ts/plugins/apiV3/risuai.d.ts",
    "check:production-bundle": "node tests/productionBundle.mjs desktop && node tests/productionBundle.mjs android android && node tests/productionBundle.mjs production",
    "check:benchmark-harnesses": "svelte-check --tsconfig benchmarks/tsconfig.json --config ./vite.config.ts && node tests/harnessCommands.mjs",
    "test:dev": "vitest run --project app --project app-node",
    "test:coverage": "vitest run --project app --project app-node --project app-extended --coverage",
    "check:tests": "svelte-check --tsconfig tests/tsconfig.json --config ./vite.config.ts",
    "test:watch": "vitest --watch --project app --project app-node",
    "test:related": "vitest related --run --project app --project app-node",
    "test:manager": "pnpm --dir server/manager/gui --ignore-workspace test",
    "test:registry": "pnpm --dir server/endpoint-registry --ignore-workspace test",
    "test:web-export": "npm --prefix tools/web-risu-export test",
    "test:node": "node scripts/runNodeTests.mjs",
    "test:harness": "vitest run --project harness && node scripts/runNodeTests.mjs --harness",
    "test:protocol": "node scripts/testNative.mjs protocol",
    "test:wasm": "pwsh -NoProfile -File scripts/testExternalStorageCore.ps1 -CoreOnly",
    "test:native": "node scripts/testNative.mjs host",
    "test:browser:agent": "playwright test --config tests/browser/playwright.config.ts",
    "test:full:shared": "pnpm check:test-inventory && pnpm check && pnpm check:tests && pnpm check:plugin-dts && pnpm test && pnpm check:production-bundle && pnpm test:node && pnpm test:manager && pnpm test:registry && pnpm test:web-export && pnpm test:protocol && pnpm test:wasm && pnpm test:browser:agent",
    "test:full": "pnpm test:full:shared && pnpm test:native && pnpm desktop:test-boundary:agent",
    "check:test-inventory": "node tests/testInventory.mjs",
    "test:release": "node --test tests/release/*.node-test.mjs",
    "test:tokenizer-corpus": "node --test benchmarks/tokenizer/corpus.node-test.mjs benchmarks/tokenizer/oracle-benchmark.node-test.mjs",
    "desktop:test-boundary:agent": "node tests/native/run.mjs",
    "desktop:dev:agent": "tauri dev --config src-tauri/tauri.agent.conf.json",
    "desktop:build:agent": "tauri build --config src-tauri/tauri.agent.conf.json -- --locked",
    "desktop:build:local": "node scripts/buildLocal.mjs",
    "desktop:build:local:agent": "node scripts/buildLocal.mjs --agent",
    "sync:windows:build": "node server/manager/install/local-build.mjs --target x86_64-pc-windows-msvc",
    "sync:linux:build": "node server/manager/install/local-build.mjs --target x86_64-unknown-linux-gnu",
    "sync:macos:build": "node server/manager/install/local-build.mjs --target aarch64-apple-darwin",
    "windows:build": "tauri build --target x86_64-pc-windows-msvc --bundles nsis -- --locked",
    "windows:build:agent": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --config src-tauri/tauri.agent.conf.json -- --locked",
    "linux:build": "tauri build --target x86_64-unknown-linux-gnu --bundles deb,appimage -- --locked",
    "linux:build:agent": "tauri build --target x86_64-unknown-linux-gnu --bundles deb,appimage --config src-tauri/tauri.agent.conf.json -- --locked",
    "macos:build": "tauri build --bundles app -- --locked",
    "macos:build:agent": "tauri build --bundles app --config src-tauri/tauri.agent.conf.json -- --locked",
    "webview:test:native": "cargo run --manifest-path tests/native/webview-navigation/Cargo.toml --locked",
    "android:test": "pwsh -NoProfile -File scripts/testAndroid.ps1",
    "android:init": "tauri android init --ci --skip-targets-install",
    "android:build:emulator": "node scripts/prepareAndroidGenerated.mjs x86_64 && tauri android build --debug --apk --target x86_64 --ci",
    "android:build:emulator:agent": "node scripts/prepareAndroidGenerated.mjs x86_64 && tauri android build --debug --apk --target x86_64 --ci --config src-tauri/tauri.agent.conf.json",
    "android:build:arm64": "node scripts/prepareAndroidGenerated.mjs aarch64 && tauri android build --debug --apk --target aarch64 --ci",
    "android:build:arm64:agent": "node scripts/prepareAndroidGenerated.mjs aarch64 && tauri android build --debug --apk --target aarch64 --ci --config src-tauri/tauri.agent.conf.json",
    "android:build:release:arm64": "node scripts/prepareAndroidGenerated.mjs aarch64 && tauri android build --apk --target aarch64 --ci -- --locked",
    "android:build:release:aab": "node scripts/prepareAndroidGenerated.mjs aarch64 && tauri android build --aab --target aarch64 --ci -- --locked",
    "ios:init:agent": "tauri ios init --ci --skip-targets-install --config src-tauri/tauri.agent.conf.json",
    "ios:build:simulator:agent": "tauri ios build --ci --target aarch64-sim --no-sign --config src-tauri/tauri.agent.conf.json",
    "ios:test:portable-source": "node scripts/testIOSPortableSourceContracts.mjs",
    "lua:build-worker": "node tools/lua-worker/build.mjs",
    "lua:check-worker": "node tools/lua-worker/build.mjs --check",
    "benchmark:vitest": "vitest bench --config vitest.benchmark.config.ts --run --pool=forks --maxWorkers=1 --no-file-parallelism",
    "benchmark:phase1": "pnpm benchmark:vitest src/ts/process/phase1Algorithms.bench.ts",
    "benchmark:streaming:display": "pnpm benchmark:vitest src/ts/process/streamingDisplayReplay.bench.ts",
    "benchmark:asset-manifest": "pnpm benchmark:vitest src/ts/storage/assetManifest.bench.ts",
    "benchmark:hypa-cache:transport": "pnpm benchmark:vitest src/ts/storage/hypaEmbeddingCache.bench.ts",
    "benchmark:phase3": "cargo test --manifest-path src-tauri/Cargo.toml --release --locked --lib persistent_store::benchmark::phase3_step5_measurements -- --ignored --exact --nocapture --test-threads=1",
    "benchmark:tokenizer:core": "cargo test --manifest-path src-tauri/Cargo.toml --release --locked native_tokenizer::tests::windows_core_benchmark -- --ignored --exact --nocapture --test-threads=1",
    "benchmark:hypa-cache": "cargo test --manifest-path src-tauri/Cargo.toml --release --locked --lib persistent_store::benchmark::hypa_embedding_cache_measurements -- --ignored --exact --nocapture --test-threads=1",
    "benchmark:phase3:tauri": "node benchmarks/phase3/tauri-cdp.mjs",
    "benchmark:tokenizer:oracle": "node benchmarks/tokenizer/oracle-benchmark.mjs",
    "benchmark:tokenizer:tauri": "node benchmarks/tokenizer/tauri-cdp.mjs",
    "benchmark:streaming:android:agent": "tauri android build --debug --apk --target x86_64 --ci --config benchmarks/streaming/tauri.conf.json"
  },
  "dependencies": {
    "@adobe/css-tools": "4.5.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@breezystack/lamejs": "^1.2.7",
    "@browsermt/bergamot-translator": "^0.4.9",
    "@dqbd/tiktoken": "^1.0.22",
    "@huggingface/jinja": "^0.5.10",
    "@huggingface/transformers": "^3.8.1",
    "@lucide/svelte": "^1.52.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@mlc-ai/web-tokenizers": "^0.1.6",
    "@risuai/ccardlib": "^0.4.2",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "2.4.10",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-fs": "2.7.0",
    "@tauri-apps/plugin-http": "2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.6",
    "@tauri-apps/plugin-updater": "2.13.1",
    "@types/markdown-it": "^14.2.0",
    "@types/trusted-types": "^2.0.7",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "astring": "^1.9.0",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "compression-streams-polyfill": "^0.1.7",
    "core-js": "^3.50.0",
    "crc": "^4.3.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.19.0",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.2",
    "mnemonist": "^0.40.4",
    "mobile-drag-drop": "3.0.0-rc.0",
    "monaco-editor": "^0.57.0",
    "msgpackr": "1.11.9",
    "ollama": "^0.6.4",
    "openid-client": "^6.8.8",
    "pdfjs-dist": "^4.10.38",
    "png-chunk-text": "^1.0.0",
    "postcss-selector-parser": "^7.1.6",
    "pyodide": "^0.27.8",
    "qrcode": "1.5.4",
    "rfdc": "^1.4.1",
    "sortablejs": "^1.15.7",
    "streamsaver": "^2.0.6",
    "sucrase": "^3.35.1",
    "sv": "^0.11.4",
    "svelte-awesome-color-picker": "^4.1.3",
    "three": "^0.154.0",
    "tippy.js": "^6.3.7",
    "uuid": "^14.0.2",
    "wasmoon": "^1.16.0",
    "wavefile": "^11.0.0",
    "web-streams-polyfill": "^4.3.0"
  },
  "devDependencies": {
    "@eslint-community/regexpp": "4.12.2",
    "@playwright/test": "1.63.0",
    "@rollup/plugin-strip": "^3.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/lodash": "^4.17.25",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/showdown": "^2.0.6",
    "@types/sortablejs": "^1.15.9",
    "@types/streamsaver": "^2.0.5",
    "@types/three": "^0.154.0",
    "@types/wicg-file-system-access": "^2020.9.8",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "12.11.1",
    "binaryen": "123.0.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "internal-ip": "^7.0.0",
    "jsdom": "28.1.0",
    "postcss": "^8.5.29",
    "source-map": "^0.7.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.11"
  }
}
