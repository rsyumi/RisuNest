{
  "name": "risunest",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --sourcemap",
    "tauribuild": "vite build --mode desktop",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "buildsite": "vite build --outDir dist",
    "runserver": "node server/node/server.cjs",
    "hono:build": "vite build --sourcemap && node server/hono/src/utils/postbuild.js",
    "tauribuild:android": "vite build --mode android",
    "tauribuild:agent": "vite build --mode agent",
    "dev:agent": "vite --mode agent",
    "build:agent": "vite build --mode agent --sourcemap",
    "check:plugin-dts": "tsc --noEmit --skipLibCheck --target es2023 --module es2022 --moduleResolution bundler --lib es2023,dom src/ts/plugins/apiV3/risuai.d.ts",
    "check:production-bundle": "node tests/productionBundle.mjs",
    "check:benchmark-harnesses": "svelte-check --tsconfig benchmarks/tsconfig.json",
    "test:release": "node --test tests/release/*.node-test.mjs",
    "test:tokenizer-corpus": "node --test benchmarks/tokenizer/corpus.node-test.mjs benchmarks/tokenizer/oracle-benchmark.node-test.mjs",
    "desktop:dev:agent": "tauri dev --config src-tauri/tauri.agent.conf.json",
    "desktop:build:agent": "tauri build --config src-tauri/tauri.agent.conf.json -- --locked",
    "windows:build": "tauri build --target x86_64-pc-windows-msvc --bundles nsis -- --locked",
    "windows:build:agent": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --config src-tauri/tauri.agent.conf.json -- --locked",
    "linux:build": "tauri build --target x86_64-unknown-linux-gnu --bundles deb,appimage -- --locked",
    "linux:build:agent": "tauri build --target x86_64-unknown-linux-gnu --bundles deb,appimage --config src-tauri/tauri.agent.conf.json -- --locked",
    "macos:build": "tauri build --bundles app -- --locked",
    "macos:build:agent": "tauri build --bundles app --config src-tauri/tauri.agent.conf.json -- --locked",
    "android:init": "tauri android init --ci --skip-targets-install",
    "android:build:emulator": "tauri android build --debug --apk --target x86_64 --ci",
    "android:build:emulator:agent": "tauri android build --debug --apk --target x86_64 --ci --config src-tauri/tauri.agent.conf.json",
    "android:build:arm64": "tauri android build --debug --apk --target aarch64 --ci",
    "android:build:arm64:agent": "tauri android build --debug --apk --target aarch64 --ci --config src-tauri/tauri.agent.conf.json",
    "android:build:release:arm64": "tauri android build --apk --target aarch64 --ci -- --locked",
    "android:build:release:aab": "tauri android build --aab --target aarch64 --ci -- --locked",
    "ios:init:agent": "tauri ios init --ci --skip-targets-install --config src-tauri/tauri.agent.conf.json",
    "ios:build:simulator:agent": "tauri ios build --ci --target aarch64-sim --no-sign --config src-tauri/tauri.agent.conf.json",
    "benchmark:vitest": "vitest bench --run --pool=forks --maxWorkers=1 --no-file-parallelism",
    "benchmark:phase1": "pnpm benchmark:vitest src/ts/process/phase1Algorithms.bench.ts",
    "benchmark:streaming:display": "pnpm benchmark:vitest src/ts/process/streamingDisplayReplay.bench.ts",
    "benchmark:asset-manifest": "pnpm benchmark:vitest src/ts/storage/assetManifest.bench.ts",
    "benchmark:phase3": "cargo test --manifest-path src-tauri/Cargo.toml --release --locked --lib persistent_store::benchmark::phase3_step5_measurements -- --ignored --exact --nocapture --test-threads=1",
    "benchmark:tokenizer:core": "cargo test --manifest-path src-tauri/Cargo.toml --release --locked native_tokenizer::tests::windows_core_benchmark -- --ignored --exact --nocapture --test-threads=1",
    "benchmark:phase3:tauri": "node benchmarks/phase3/tauri-cdp.mjs",
    "benchmark:tokenizer:oracle": "node benchmarks/tokenizer/oracle-benchmark.mjs",
    "benchmark:tokenizer:tauri": "node benchmarks/tokenizer/tauri-cdp.mjs",
    "benchmark:streaming:android:agent": "tauri android build --debug --apk --target x86_64 --ci --config benchmarks/streaming/tauri.conf.json"
  },
  "dependencies": {
    "@adobe/css-tools": "4.4.4",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@breezystack/lamejs": "^1.2.7",
    "@browsermt/bergamot-translator": "^0.4.9",
    "@dqbd/tiktoken": "^1.0.22",
    "@huggingface/jinja": "^0.2.2",
    "@huggingface/transformers": "^3.8.1",
    "@lucide/svelte": "^0.562.0",
    "@mlc-ai/web-llm": "^0.2.80",
    "@mlc-ai/web-tokenizers": "^0.1.6",
    "@risuai/ccardlib": "^0.4.2",
    "@smithy/protocol-http": "^3.3.0",
    "@smithy/signature-v4": "^2.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.6",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@types/markdown-it": "^14.1.2",
    "@types/trusted-types": "^2.0.7",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "astring": "^1.9.0",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "compression-streams-polyfill": "^0.1.7",
    "core-js": "^3.47.0",
    "crc": "^4.3.2",
    "diff": "^7.0.0",
    "dompurify": "^3.3.2",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.2",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.27",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "mnemonist": "^0.40.3",
    "mobile-drag-drop": "3.0.0-rc.0",
    "monaco-editor": "^0.55.1",
    "msgpackr": "1.10.1",
    "node-html-parser": "^6.1.13",
    "ollama": "^0.5.18",
    "openid-client": "^6.8.1",
    "pdfjs-dist": "^4.10.38",
    "peerjs": "^1.5.5",
    "png-chunk-text": "^1.0.0",
    "postcss-selector-parser": "^7.1.1",
    "pyodide": "^0.27.7",
    "qrcode": "1.5.4",
    "rfdc": "^1.4.1",
    "sortablejs": "^1.15.6",
    "streamsaver": "^2.0.6",
    "sucrase": "^3.35.1",
    "sv": "^0.11.0",
    "svelte-awesome-color-picker": "^4.1.0",
    "three": "^0.154.0",
    "tippy.js": "^6.3.7",
    "uuid": "^9.0.1",
    "wasmoon": "^1.16.0",
    "wavefile": "^11.0.0",
    "web-streams-polyfill": "^3.3.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint-community/regexpp": "4.12.2",
    "@rollup/plugin-strip": "^3.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@swc/core": "1.5.7",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "2.11.4",
    "@tsconfig/svelte": "^5.0.6",
    "@types/diff": "^6.0.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/lodash": "^4.17.21",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^22.19.3",
    "@types/qrcode": "1.5.6",
    "@types/showdown": "^2.0.6",
    "@types/sortablejs": "^1.15.9",
    "@types/streamsaver": "^2.0.5",
    "@types/three": "^0.154.0",
    "@types/uuid": "^9.0.8",
    "@types/wicg-file-system-access": "^2020.9.8",
    "autoprefixer": "^10.4.23",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.5.3",
    "happy-dom": "^20.1.0",
    "internal-ip": "^7.0.0",
    "postcss": "^8.5.6",
    "source-map": "^0.7.6",
    "svelte": "^5.55.1",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "^4.1.0"
  }
}
