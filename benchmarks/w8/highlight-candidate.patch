diff --git a/src/ts/parser/highlightLoader.ts b/src/ts/parser/highlightLoader.ts
new file mode 100644
index 00000000..9e0f2132
--- /dev/null
+++ b/src/ts/parser/highlightLoader.ts
@@ -0,0 +1,36 @@
+import type { HLJSApi, LanguageFn } from 'highlight.js'
+
+export type HighlightLanguageImporter = () => Promise<{ default: LanguageFn }>
+
+let corePromise: Promise<HLJSApi> | null = null
+const languagePromises = new Map<string, Promise<void>>()
+
+export function getHighlightCore(): Promise<HLJSApi> {
+    corePromise ??= import('highlight.js/lib/core').then((module) => module.default)
+    return corePromise
+}
+
+export async function loadHighlightLanguage(
+    languageName: string,
+    importer: HighlightLanguageImporter,
+): Promise<HLJSApi> {
+    const highlighter = await getHighlightCore()
+    if (highlighter.getLanguage(languageName)) return highlighter
+
+    let pending = languagePromises.get(languageName)
+    if (!pending) {
+        pending = importer().then((module) => {
+            if (!highlighter.getLanguage(languageName)) {
+                highlighter.registerLanguage(languageName, module.default)
+            }
+        })
+        languagePromises.set(languageName, pending)
+    }
+    try {
+        await pending
+    } catch (error) {
+        languagePromises.delete(languageName)
+        throw error
+    }
+    return highlighter
+}
